# Publish only the application, its required assets, and public project metadata.
# Research, local tests, recordings, downloads, and generated exports stay local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/LICENSE
!/index.html
!/style.css
!/app.mjs
!/core.mjs
!/renderer.mjs
!/export.mjs
!/assets/
/assets/*
!/assets/hand-pen.png
!/assets/LICENSE-hand.txt
!/assets/demo.mp4
!/assets/demo.gif
